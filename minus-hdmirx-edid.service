[Unit]
Description=Cap HDMI-RX at 4K30 / 1080p60 (no 4K60) via its EDID
Before=minus.service
After=systemd-udev-settle.service

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -e /dev/video0 ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/v4l2-ctl -d /dev/video0 --set-edid=file=/etc/minus/hdmirx-edid-4k30-1080p60.bin,format=raw
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
