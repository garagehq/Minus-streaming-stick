[Unit]
Description=Minus auto-update a few minutes after boot (retries every 5 min until online)

[Timer]
# 3 min after boot, then 5 min after each run. The script updates once per
# boot (stamp in /run) and exits at once after that.
OnBootSec=3min
OnUnitInactiveSec=5min

[Install]
WantedBy=timers.target
